# RepoPilot configuration. Copy to .env for local use. Every line except the key is optional.
# .env is git-ignored. Never commit it.

# --- The one secret -------------------------------------------------------------------------
# Your Google Gemini API key (create one at https://aistudio.google.com/apikey).
# Visitors never enter or see it. On a hosted deployment, set it as a secret environment
# variable in your host's dashboard instead of using a file. Leave it empty to run demo-only.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model ----------------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# Optional: minimal | low | medium | high. Empty uses the model's default.
GEMINI_THINKING_LEVEL=

# --- Public deployment safety ---------------------------------------------------------------
# true  = for anything except the built-in demos, do NOT run the repository's tests
#         (running a stranger's test suite is running a stranger's code on your server).
# false = run tests for any repo. Only do this on your own machine.
PUBLIC_MODE=true
# Set true only when running behind a reverse proxy you control (uses X-Forwarded-For for per-IP limits).
TRUST_PROXY=false

# Spend controls. Cost figures are estimates from token counts and the prices below.
MAX_COST_USD=0.25            # per run
DAILY_COST_CAP_USD=5.00      # rolling 24h, across all visitors; live runs pause when reached
RUNS_PER_IP_PER_HOUR=6       # live AI runs per IP address
MAX_STEPS=30
PRICE_INPUT_PER_MTOK=1.50    # USD per million tokens (conservative standard rate)
PRICE_OUTPUT_PER_MTOK=7.50   # thinking tokens are billed as output

# Capacity and cleanup
SESSIONS_PER_OWNER=5         # repositories each visitor may keep at once
MAX_SESSIONS=60              # across the whole server
SESSION_TTL_HOURS=24         # workspaces are deleted after this long
MAX_REPO_MB=100
MAX_CONCURRENT_RUNS=4
APPROVAL_TIMEOUT_S=600       # an unanswered approval expires after this long

# Agent limits
MAX_FILES_CHANGED=10
MAX_CHANGED_LINES=400
AUTO_CONFIDENCE_THRESHOLD=0.8
TEST_TIMEOUT_S=120

# Server
PORT=8000
# HOST=127.0.0.1             # default. The Docker image sets 0.0.0.0.
ALLOWED_GIT_HOSTS=github.com
ALLOW_LOCAL_PATHS=false      # development only

# --- Production SaaS ------------------------------------------------------------------------
# PostgreSQL is the identity/tenant database. Run `alembic upgrade head` before the app.
DATABASE_URL=postgresql+psycopg://repopilot:change-me@localhost:5432/repopilot
AUTH_REQUIRED=false          # true in production; false keeps the anonymous demo compatibility mode
AUTH_AUTO_CREATE=false       # tests/local-only convenience; production uses Alembic
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
APP_BASE_URL=http://localhost:8000
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# OAuth callback URLs: {APP_BASE_URL}/api/auth/oauth/google/callback and /github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Workers and billing
REDIS_URL=redis://localhost:6379/0
QUEUE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FREE_MONTHLY_RUNS=20
PAID_MONTHLY_RUNS=500
FREE_CONCURRENT_RUNS=1
PAID_CONCURRENT_RUNS=5
ADMIN_EMAILS=
